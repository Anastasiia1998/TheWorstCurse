<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Kumar+One&amp;family=DM+Sans:wght@400;500;700&amp;display=swap" rel="stylesheet">
<style>
  html, body { margin: 0; padding: 0; background: #17151D; }
  a { color: #f2eef0; text-decoration: none; }
  a:hover { color: #ff9ec0; }
  input::placeholder, textarea::placeholder { color: rgba(245,245,245,0.42); }
  @keyframes seal-in { 0% { transform: scale(.4) rotate(-24deg); opacity: 0 } 62% { transform: scale(1.08) rotate(4deg); opacity: 1 } 100% { transform: scale(1) rotate(0deg); opacity: 1 } }
  @keyframes seal-ring { 0% { transform: scale(.5); opacity: .8 } 100% { transform: scale(2.1); opacity: 0 } }
  @keyframes rise-in { 0% { transform: translateY(16px); opacity: 0 } 100% { transform: translateY(0); opacity: 1 } }
</style>
</helmet>
<div id="home" style="position: relative; width: 100%; min-height: 100vh; overflow: hidden; background: #17151D; font-family: 'DM Sans', Helvetica, sans-serif; isolation: isolate;">

  <canvas ref="{{ blobRef }}" style="position: absolute; inset: -4%; width: 108%; height: 108%; filter: blur(7px); opacity: 0.2; pointer-events: none;"></canvas>

  <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(141,51,71,0.92) 0%, rgba(92,40,54,0.72) 16%, rgba(23,21,29,0.5) 34%, rgba(23,21,29,0.3) 100%); pointer-events: none;"></div>

  <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; pointer-events: none;">
    <div style="flex: 0 0 auto; height: clamp(120px, 20vh, 230px);"></div>
    <div style="flex: 0 0 auto; width: 100%; display: flex; justify-content: center;">
      <canvas ref="{{ textRef }}" style="width: 100%; max-width: 1180px; height: clamp(160px, 31vh, 300px); display: block;"></canvas>
    </div>
    <div style="flex: 1 1 auto; min-height: 0;"></div>
  </div>

  <div style="position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); display: flex; justify-content: center; align-items: flex-end; pointer-events: none;">
    <span style="position: relative; display: inline-block; filter: drop-shadow(0 30px 60px rgba(20,10,25,0.5));">
      <img src="assets/man.png" alt="Old man in crocheted candy-colored coat" style="height: min(58vh, 640px); max-width: 92vw; width: auto; display: block; object-fit: contain; object-position: bottom;">
    </span>
  </div>

  <div style="position: absolute; left: 0; right: 0; top: 0; display: flex; justify-content: center; align-items: center; padding: 28px clamp(20px, 4vw, 56px);">
    <nav style="display: flex; flex-wrap: nowrap; justify-content: center; align-items: center; gap: 4px; padding: 7px 10px; max-width: 100%; border-radius: 999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.16); backdrop-filter: blur(14px);">
      <a href="#home" onClick="{{ go }}" style="padding: 9px 16px; border-radius: 999px; font-size: 13.5px; font-weight: 500; letter-spacing: 0.02em; color: rgba(250,246,248,0.92);" style-hover="background: rgba(255,255,255,0.12); color: #fff;">Home</a>
      <a href="#make-a-curse" onClick="{{ go }}" style="padding: 9px 16px; border-radius: 999px; font-size: 13.5px; font-weight: 500; letter-spacing: 0.02em; color: rgba(250,246,248,0.92);" style-hover="background: rgba(255,255,255,0.12); color: #fff;">Make a Curse</a>
      <a href="#how-it-works" onClick="{{ go }}" style="padding: 9px 16px; border-radius: 999px; font-size: 13.5px; font-weight: 500; letter-spacing: 0.02em; color: rgba(250,246,248,0.92);" style-hover="background: rgba(255,255,255,0.12); color: #fff;">How It Works</a>
      <a href="#faqs" onClick="{{ go }}" style="padding: 9px 16px; border-radius: 999px; font-size: 13.5px; font-weight: 500; letter-spacing: 0.02em; color: rgba(250,246,248,0.92);" style-hover="background: rgba(255,255,255,0.12); color: #fff;">FAQs</a>
    </nav>
  </div>

  <div style="position: absolute; left: clamp(20px, 4vw, 56px); bottom: clamp(30px, 6vh, 62px); display: flex; align-items: center; pointer-events: none;">
    <span style="display: flex; align-items: center; gap: 9px;">
      <span style="width: 19px; height: 21px; overflow: hidden; display: block;">
        <img src="assets/url.svg" alt="" style="height: 21px; width: auto; display: block;">
      </span>
      <span style="font-size: 12.5px; font-weight: 500; letter-spacing: 0.1em; color: #F5F5F5; text-transform: uppercase;">theworstcurse.net</span>
    </span>
  </div>

  <a href="#make-a-curse" onClick="{{ go }}" style="position: absolute; right: clamp(20px, 4vw, 56px); bottom: clamp(24px, 5vh, 56px); width: 82px; height: 82px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.07); backdrop-filter: blur(10px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;" style-hover="background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.5);">
    <span style="font-size: 9.5px; font-weight: 500; letter-spacing: 0.18em; color: rgba(250,246,248,0.8); text-transform: uppercase; text-align: center; line-height: 1.4;">Scroll<br>down</span>
    <span style="font-size: 15px; line-height: 1; color: rgba(250,246,248,0.85);">↓</span>
  </a>
</div>

<section id="make-a-curse" data-screen-label="Make a Curse" style="position: relative; box-sizing: border-box; width: 100%; background: #17151D; font-family: 'DM Sans', Helvetica, sans-serif; overflow: hidden; padding: clamp(56px, 9vh, 104px) clamp(20px, 4vw, 56px) clamp(80px, 13vh, 150px); padding-top: clamp(120px, 9vh, 104px); padding-bottom: clamp(100px, 13vh, 100px)">
  <div style="position: absolute; inset: 0; opacity: 0.4; background: linear-gradient(180deg, rgba(223,72,95,0.6) 0%, #9D3749 3%, #732C3B 14%, #17151D 34%, #17151D 100%); pointer-events: none;"></div>

  <div style="position: relative; max-width: 532px; margin: 0 auto;">
  <div style="{{ formWrap }}">
    <div style="display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center;">
      <h2 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(38px, 6.4vw, 62px); line-height: 1.1; color: #F5F5F5; text-wrap: pretty;">Make a Curse</h2>
      <p style="margin: 0; font-size: 15px; line-height: 1.6; color: rgba(245,245,245,0.66);">Choose wisely. They probably deserve it.</p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h3 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(21px, 2.4vw, 26px); line-height: 1.3; color: #F5F5F5;">Victim Name</h3>
      <input type="text" value="{{ target }}" onInput="{{ onTarget }}" placeholder="Enter a name or nickname..." style="width: 100%; box-sizing: border-box; padding: 15px 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.035); color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 15.5px; font-weight: 400; outline: none;" style-focus="border-color: rgba(223,72,95,0.8); background: rgba(255,255,255,0.06);">
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h3 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(21px, 2.4vw, 26px); line-height: 1.3; color: #F5F5F5;">Choose Their Fate</h3>
      <span style="position: relative; display: block;">
        <select value="{{ fate }}" onChange="{{ onFate }}" style="width: 100%; box-sizing: border-box; padding: 15px 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.035); color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 15.5px; font-weight: 400; outline: none; appearance: none; -webkit-appearance: none; padding-right: 44px; cursor: pointer;" style-focus="border-color: rgba(223,72,95,0.8); background: rgba(255,255,255,0.06);">
          <option value="" style="background: #221d26;">Select a curse...</option>
          <sc-for list="{{ fates }}" as="f" hint-placeholder-count="5">
            <option value="{{ f }}" style="background: #221d26;">{{ f }}</option>
          </sc-for>
        </select>
        <span style="position: absolute; right: 18px; top: 50%; margin-top: -9px; font-size: 13px; line-height: 1; color: rgba(245,245,245,0.6); pointer-events: none;">▾</span>
      </span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
      <h3 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(21px, 2.4vw, 26px); line-height: 1.3; color: #F5F5F5;">Not Evil Enough?</h3>
      <p style="margin: 0; font-size: 15px; line-height: 1.6; color: rgba(245,245,245,0.66);">Create your own curse – <span style="font-weight: 700; color: #F5F5F5;">$4.99</span></p>
      <p style="margin: 0; font-size: 15px; line-height: 1.6; color: rgba(245,245,245,0.66);">Got something more annoyingly specific in mind? Write your own completely fictional inconvenience.</p>
      <textarea value="{{ custom }}" onInput="{{ onCustom }}" rows="3" placeholder="Enter your curse..." style="width: 100%; box-sizing: border-box; padding: 15px 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.035); color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 15.5px; font-weight: 400; outline: none; min-height: 96px; line-height: 1.55; resize: vertical;" style-focus="border-color: rgba(223,72,95,0.8); background: rgba(255,255,255,0.06);"></textarea>
    </div>

    <div style="display: flex; flex-direction: column; gap: 16px; margin-top: 14px;">
      <h3 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(21px, 2.4vw, 26px); line-height: 1.3; color: #F5F5F5;">Pay &amp; Cast</h3>
      <p style="margin: 0; font-size: 15px; line-height: 1.6; color: rgba(245,245,245,0.66);">Secure checkout. No refunds for the damned.</p>

      <div style="display: flex; flex-direction: column; gap: 9px;">
        <span style="font-size: 14px; font-weight: 400; color: rgba(245,245,245,0.72);">Card number</span>
        <input type="text" inputmode="numeric" value="{{ card }}" onInput="{{ onCard }}" placeholder="1234 5678 9012 3456" style="width: 100%; box-sizing: border-box; padding: 15px 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.035); color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 15.5px; font-weight: 400; outline: none;" style-focus="border-color: rgba(223,72,95,0.8); background: rgba(255,255,255,0.06);" />
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 14px;">
        <div style="display: flex; flex-direction: column; gap: 9px; min-width: 0;">
          <span style="font-size: 14px; font-weight: 400; color: rgba(245,245,245,0.72);">Expiry date</span>
          <input type="text" value="{{ expiry }}" onInput="{{ onExpiry }}" placeholder="MM/YY" style="width: 100%; box-sizing: border-box; padding: 15px 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.035); color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 15.5px; font-weight: 400; outline: none;" style-focus="border-color: rgba(223,72,95,0.8); background: rgba(255,255,255,0.06);" />
        </div>
        <div style="display: flex; flex-direction: column; gap: 9px; min-width: 0;">
          <span style="font-size: 14px; font-weight: 400; color: rgba(245,245,245,0.72);">CVV</span>
          <input type="text" inputmode="numeric" value="{{ cvv }}" onInput="{{ onCvv }}" placeholder="123" style="width: 100%; box-sizing: border-box; padding: 15px 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.035); color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 15.5px; font-weight: 400; outline: none;" style-focus="border-color: rgba(223,72,95,0.8); background: rgba(255,255,255,0.06);" />
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 9px;">
        <span style="font-size: 14px; font-weight: 400; color: rgba(245,245,245,0.72);">Cardholder name</span>
        <input type="text" value="{{ holder }}" onInput="{{ onHolder }}" placeholder="Name on card" style="width: 100%; box-sizing: border-box; padding: 15px 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.035); color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 15.5px; font-weight: 400; outline: none;" style-focus="border-color: rgba(223,72,95,0.8); background: rgba(255,255,255,0.06);" />
      </div>
    </div>

    <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; margin-top: 8px; width: 534px; height: 47px">
      <button type="button" onClick="{{ onCast }}" style="padding: 15px 30px; border-radius: 999px; border: none; background: #DF485F; color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 15px; font-weight: 500; cursor: pointer;" style-hover="background: #C63A50;">{{ castLabel }}</button>
      <span style="min-height: 19px; font-size: 13.5px; color: rgba(245,245,245,0.7); text-align: center;">{{ castNote }}</span>
    </div>
  </div>

  <div style="{{ successWrap }}">
    <h2 style="{{ sh1 }}">Curse successfully sent.</h2>
    <p style="{{ sh2 }}">It&rsquo;s out of your hands now.</p>
    <div style="{{ sBtnWrap }}">
      <button type="button" onClick="{{ onReset }}" style="padding: 14px 28px; border-radius: 999px; border: none; background: #DF485F; color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 16px; font-weight: 400; cursor: pointer; transition: background .3s ease;" style-hover="background: #C63A50;">Curse Someone Else</button>
      <span style="font-size: clamp(14px, 1.7vw, 16px); color: rgba(245,245,245,0.62);">They deserve it.</span>
    </div>
  </div>
  </div>
</section>

<section id="how-it-works" data-screen-label="How It Works" style="position: relative; box-sizing: border-box; width: 100%; background: #17151D; font-family: 'DM Sans', Helvetica, sans-serif; overflow: hidden; padding: clamp(60px, 10vh, 112px) clamp(20px, 4vw, 56px) clamp(64px, 10vh, 116px); padding-top: clamp(100px, 10vh, 112px); padding-bottom: clamp(100px, 10vh, 116px)">
  <div style="position: relative; max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(38px, 6vh, 66px);">
    <div style="display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center;">
      <h2 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(38px, 6.4vw, 62px); line-height: 1.1; color: #F5F5F5; text-wrap: pretty;">How It Works</h2>
      <p style="margin: 0; font-size: 15px; line-height: 1.6; color: rgba(245,245,245,0.66);">No complicated rituals. No full moon required. Just three simple steps.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: clamp(20px, 2.6vw, 34px);">
      <article style="display: flex; flex-direction: column; justify-content: space-between; gap: 40px; min-height: 414px; padding: 34px 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: linear-gradient(168deg, rgba(23,21,29,0.9) 0%, rgba(80,36,48,0.42) 52%, rgba(141,51,71,0.3) 100%); box-shadow: 0 22px 50px rgba(12,8,14,0.45);">
        <span style="font-size: 13px; font-weight: 400; letter-spacing: 0.04em; color: rgba(245,245,245,0.5); text-align: center;">(01)</span>
        <h3 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(24px, 2.6vw, 31px); line-height: 1.28; color: #F5F5F5; text-align: center;">Name Your<br>Victim</h3>
        <p style="margin: 0; font-size: 14px; line-height: 1.62; color: rgba(245,245,245,0.7); text-align: center; text-wrap: pretty;">Enter the name of the person who deserves a little cosmic inconvenience.</p>
      </article>
      <article style="display: flex; flex-direction: column; justify-content: space-between; gap: 40px; min-height: 414px; padding: 34px 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: linear-gradient(168deg, rgba(23,21,29,0.9) 0%, rgba(80,36,48,0.42) 52%, rgba(141,51,71,0.3) 100%); box-shadow: 0 22px 50px rgba(12,8,14,0.45);">
        <span style="font-size: 13px; font-weight: 400; letter-spacing: 0.04em; color: rgba(245,245,245,0.5); text-align: center;">(02)</span>
        <h3 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(24px, 2.6vw, 31px); line-height: 1.28; color: #F5F5F5; text-align: center;">Choose<br>Their Fate</h3>
        <p style="margin: 0; font-size: 14px; line-height: 1.62; color: rgba(245,245,245,0.7); text-align: center; text-wrap: pretty;">Pick one of our carefully selected curses – or write your own if you’re feeling creative.</p>
      </article>
      <article style="display: flex; flex-direction: column; justify-content: space-between; gap: 40px; min-height: 414px; padding: 34px 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: linear-gradient(168deg, rgba(23,21,29,0.9) 0%, rgba(80,36,48,0.42) 52%, rgba(141,51,71,0.3) 100%); box-shadow: 0 22px 50px rgba(12,8,14,0.45);">
        <span style="font-size: 13px; font-weight: 400; letter-spacing: 0.04em; color: rgba(245,245,245,0.5); text-align: center;">(03)</span>
        <h3 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(24px, 2.6vw, 31px); line-height: 1.28; color: #F5F5F5; text-align: center;">Cast The<br>Curse</h3>
        <p style="margin: 0; font-size: 14px; line-height: 1.62; color: rgba(245,245,245,0.7); text-align: center; text-wrap: pretty;">Complete your order and leave the rest to the universe. Their slightly worse day is now out of your hands.</p>
      </article>
    </div>

    <p style="margin: 0; text-align: center; font-size: 14.5px; color: rgba(245,245,245,0.62);">✦ 100% true. 100% actual supernatural power. ✦</p>
  </div>
</section>
<section id="faqs" data-screen-label="FAQs" style="position: relative; box-sizing: border-box; width: 100%; background: #17151D; font-family: 'DM Sans', Helvetica, sans-serif; overflow: hidden; padding: clamp(60px, 10vh, 112px) clamp(20px, 4vw, 56px) clamp(72px, 12vh, 140px); padding-top: clamp(100px, 10vh, 112px); padding-bottom: clamp(120px, 12vh, 140px)">
  <div style="position: absolute; left: 50%; bottom: -30%; width: min(140vw, 1600px); height: 60%; transform: translateX(-50%); background: radial-gradient(ellipse at 50% 100%, rgba(141,51,71,0.4) 0%, rgba(92,40,54,0.18) 46%, rgba(23,21,29,0) 74%); pointer-events: none;"></div>

  <div style="position: relative; max-width: 728px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(38px, 6vh, 74px);">
    <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center;">
      <h2 style="margin: 0; font-family: 'Kumar One', Georgia, serif; font-weight: 400; font-size: clamp(38px, 6.4vw, 62px); line-height: 1.1; color: #F5F5F5;">FAQs</h2>
      <p style="margin: 0; font-size: 16px; line-height: 1.6; color: rgba(245,245,245,0.66);">Questions before you ruin someone’s day? Fair enough.</p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 28px;">
      <sc-for list="{{ faqs }}" as="item" hint-placeholder-count="4">
        <div style="border-radius: 16px; border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.022); overflow: hidden;">
          <button type="button" onClick="{{ item.toggle }}" style="width: 100%; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 22px 24px; border: none; background: transparent; color: #F5F5F5; font-family: 'DM Sans', Helvetica, sans-serif; font-size: 17px; font-weight: 400; letter-spacing: -0.005em; text-align: left; cursor: pointer;" style-hover="background: rgba(255,255,255,0.04);">
            <span>{{ item.q }}</span>
            <span style="flex: 0 0 auto; width: 10px; height: 10px; display: block; position: relative;">
              <span style="{{ item.chevron }}"></span>
            </span>
          </button>
          <div style="{{ item.body }}">
            <div style="min-height: 0; overflow: hidden;">
              <p style="margin: 0; padding: 0 24px 22px; font-size: 15px; line-height: 1.66; color: rgba(245,245,245,0.62); text-wrap: pretty;">{{ item.a }}</p>
            </div>
          </div>
        </div>
      </sc-for>
    </div>
  </div>
</section>
<footer data-screen-label="Footer" style="position: relative; box-sizing: border-box; width: 100%; height: min(52vh, 500px); min-height: 340px; overflow: hidden; background: #17151D; font-family: 'DM Sans', Helvetica, sans-serif; isolation: isolate;">

  <canvas ref="{{ footBlobRef }}" style="position: absolute; inset: -4%; width: 108%; height: 108%; filter: blur(7px); opacity: 0.2; pointer-events: none;"></canvas>

  <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(141,51,71,0.92) 0%, rgba(92,40,54,0.72) 16%, rgba(23,21,29,0.5) 34%, rgba(23,21,29,0.3) 100%); pointer-events: none;"></div>

  <div style="position: absolute; left: 0; right: 0; top: 44px; display: flex; justify-content: center; pointer-events: none;">
    <canvas ref="{{ footTextRef }}" style="width: 100%; max-width: 1320px; height: clamp(130px, 42vh, 230px); display: block;"></canvas>
  </div>

  <div style="position: absolute; left: 50%; bottom: 0; height: 100%; transform: translateX(-50%); display: flex; justify-content: center; align-items: flex-end; pointer-events: none;">
